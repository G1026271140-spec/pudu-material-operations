[Unit]
Description=PUDU PostgreSQL and application files backup
After=postgresql.service

[Service]
Type=oneshot
User=gaohongyuan1
WorkingDirectory=/home/gaohongyuan1/pudu-materials-operation/source
Environment=PUDU_DATABASE_DSN=dbname=pudu_materials
Environment=PUDU_DEPLOY_ROOT=/home/gaohongyuan1/pudu-materials-operation
Environment=TZ=Asia/Shanghai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/gaohongyuan1/pudu-materials-operation/venv/bin/python -m material_store.backup
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/gaohongyuan1/pudu-materials-operation/shared/backups
